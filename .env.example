# Copy to .env and fill in real values. .env itself is gitignored — never commit secrets.

FAKESTORE_API_URL=https://fakestoreapi.com/products

DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=fakestore_catalog
DATABRICKS_SCHEMA=etl_project

KAFKA_BOOTSTRAP_SERVER=
KAFKA_TOPIC=validated_products
# empty = PLAINTEXT (local broker). Amazon MSK: SASL_SSL + AWS_MSK_IAM
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=

# Trino (serving/) - the Streamlit Product Activity page reads delta.lakehouse here
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=streamlit

# ---------------------------------------------------------------------------
# Phase II: logging (observability/logging_config.py)
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# default: <project>/logs
LOG_DIR=
# console format: text | json (json when stdout is shipped to CloudWatch Logs)
LOG_FORMAT=text
LOG_TO_FILE=true

# ---------------------------------------------------------------------------
# Phase II: alerts (observability/alerts.py) — every alert is also written to
# logs/alerts.jsonl, so leaving the channels empty never loses an alert.
# ---------------------------------------------------------------------------
ALERTS_ENABLED=true
# info | warning | error | critical — lower ones only go to logs/alerts.jsonl
ALERT_MIN_SEVERITY=warning
ALERT_COOLDOWN_SECONDS=300
# shown in every alert: local / dev / prod
ALERT_ENV=local

# Slack: Apps -> Incoming Webhooks -> Add New Webhook to Workspace
SLACK_WEBHOOK_URL=

# Email (SMTP). Gmail: smtp.gmail.com, port 587, an App Password as SMTP_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_EMAIL_FROM=
# comma-separated
ALERT_EMAIL_TO=

# Amazon SNS topic (cloud: the same topic the CloudWatch alarms publish to)
ALERT_SNS_TOPIC_ARN=

# ---------------------------------------------------------------------------
# Phase II: latency / data-quality alert thresholds
# ---------------------------------------------------------------------------
# Kafka -> Databricks end-to-end latency per message (kafka1/consumer.py)
LATENCY_ALERT_SECONDS=300
# share of products the validate step may drop before a warning (pipeline_tasks.py)
VALIDATION_REJECT_ALERT_RATIO=0.2
# per-task latency SLA overrides, e.g. SLA_SECONDS_EXTRACT=60 (defaults in pipeline_tasks.py)
SLA_SECONDS_EXTRACT=
SLA_SECONDS_SEND_TO_KAFKA=
# Spark stream (observability/stream_health.py)
STREAM_LATENCY_ALERT_SECONDS=120
STREAM_REJECT_ALERT_RATIO=0.25
STREAM_REJECT_MIN_MESSAGES=20
STREAM_TRIGGER_ALERT_SECONDS=60

# ---------------------------------------------------------------------------
# Phase II: metrics (observability/metrics.py) — always logs/metrics.jsonl and
# logs/metrics_<component>.prom; optionally pushed to a Prometheus Pushgateway
# ---------------------------------------------------------------------------
PUSHGATEWAY_URL=

# ---------------------------------------------------------------------------
# Phase II: data lineage (governance/lineage.py) — always logs/lineage/openlineage.jsonl;
# optionally sent to an OpenLineage backend, e.g. Marquez at http://localhost:5000
# ---------------------------------------------------------------------------
OPENLINEAGE_URL=
OPENLINEAGE_ENDPOINT=api/v1/lineage
OPENLINEAGE_API_KEY=
OPENLINEAGE_NAMESPACE=fakestore_etl
LINEAGE_LAKEHOUSE_NAMESPACE=hive://embedded-derby
LINEAGE_TRINO_NAMESPACE=trino://localhost:8080

# ---------------------------------------------------------------------------
# Streaming lakehouse (streaming/) — defaults are the local WSL setup
# ---------------------------------------------------------------------------
STREAM_KAFKA_BOOTSTRAP=localhost:9092
STREAM_KAFKA_TOPIC=user-events
# local (default) | cluster (EMR / Databricks: the cluster supplies master, jars, metastore)
LAKEHOUSE_MODE=local
# default: streaming/_lakehouse ; in the cloud e.g. s3://<bucket>/lakehouse
LAKEHOUSE_ROOT=

# Cloud runtimes (deploy/README.md): JSON to stdout, no local files, metrics as log lines
METRICS_TO_LOG=false
# AWS Secrets Manager JSON secret with the secret settings above (cloud only)
PIPELINE_SECRET_ID=
AWS_REGION=
